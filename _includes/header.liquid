{% assign current_lang = page.lang | default: 'en' %}
{% assign home_url = '/' %}
{% assign alternate_lang = 'zh-CN' %}
{% assign alternate_label = '中文' %}
{% assign alternate_aria = '切换至中文版' %}
{% assign current_marker = '(current)' %}
{% assign nav_toggle_label = 'Toggle navigation' %}
{% assign search_label = 'Open search' %}
{% assign theme_label = 'Change color theme' %}
{% assign localized_site_title = site.title %}
{% if current_lang contains 'zh' %}
  {% assign home_url = '/zh/' %}
  {% assign alternate_lang = 'en' %}
  {% assign alternate_label = 'EN' %}
  {% assign alternate_aria = 'Switch to English' %}
  {% assign current_marker = '（当前）' %}
  {% assign nav_toggle_label = '切换导航' %}
  {% assign search_label = '打开搜索' %}
  {% assign theme_label = '切换配色' %}
  {% assign localized_site_title = '马子睿' %}
{% endif %}
{% assign language_url = page.translation_url %}
{% if language_url == blank %}
  {% if current_lang contains 'zh' %}
    {% assign language_url = '/' %}
  {% else %}
    {% assign language_url = '/zh/' %}
  {% endif %}
{% endif %}

<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != home_url %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- localized_site_title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}

      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{{ nav_toggle_label }}"
      >
        <span class="sr-only">{{ nav_toggle_label }}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% assign about_title = 'About' %}
          {% for nav_page in site.pages %}
            {% assign nav_page_lang = nav_page.lang | default: 'en' %}
            {% if nav_page.permalink == home_url and nav_page_lang == current_lang %}
              {% assign about_title = nav_page.title %}
            {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}">
              {{- about_title }}
              {% if page.permalink == home_url %}
                <span class="sr-only">{{ current_marker }}</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_lang = p.lang | default: 'en' %}
            {% if p.nav and p.autogen == null and p_lang == current_lang %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">{{ current_marker }}</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">{{ current_marker }}</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}

          <li class="nav-item language-switch">
            <a
              class="nav-link"
              href="{{ language_url | relative_url }}"
              lang="{{ alternate_lang }}"
              hreflang="{{ alternate_lang }}"
              aria-label="{{ alternate_aria }}"
            >
              <i class="fa-solid fa-language" aria-hidden="true"></i><span>{{ alternate_label }}</span>
            </a>
          </li>

          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="{{ search_label }}" aria-label="{{ search_label }}">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toggle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="{{ theme_label }}" aria-label="{{ theme_label }}">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>

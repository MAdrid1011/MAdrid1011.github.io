@inproceedings{ma2026scarf,
  abbr            = {MICRO'26},
  title           = {SCARF: A Scene-Adaptive Depth-Guided G-3DGS Encoder Accelerator with Semantic Reuse and Fused Dataflow},
  author          = {Ma, Zirui and Fan, Zhihua and Wu, Haibin and Li, Wenxing and Zhang, Fulin and Fan, Dongrui and Ye, Xiaochun and Li, Wenming},
  booktitle       = {59th IEEE/ACM International Symposium on Microarchitecture},
  year            = {2026},
  preview         = {scarf.webp},
  abstract        = {Depth-guided, cost-volume-based Generalizable 3D Gaussian Splatting (G-3DGS) encoders reconstruct scenes as sets of Gaussian primitives directly from multi-view images without requiring per-scene optimization, thereby facilitating feed-forward novel-view synthesis on edge computing platforms. However, their shared encoder architecture presents two primary bottlenecks. First, the per-pixel depth search disregards semantic similarity within the 2D feature space, causing depth search operations to account for over 65\% of memory traffic due to redundant exhaustive candidate scans. Second, the sequential pipeline of depth prediction followed by Gaussian generation neglects local 3D geometric continuity, resulting in more than 52\% of generated Gaussians being redundant prior to instantiation. In this paper, we introduce SCARF, a dataflow-co-designed accelerator that aligns each bottleneck with a corresponding scene-level regularity. To mitigate the first bottleneck, Feature Similarity Depth Reuse reconceptualizes depth search as a problem of semantic locality: depth consistency is determined by affinity in feature space rather than physical address proximity. It transforms exhaustive per-pixel depth searches into anchor-centered local searches. To overcome the second bottleneck, Scene-Adaptive Early Sparsification disrupts the conventional serial depth-to-materialization boundary by probing each tile to infer local scene regularity. It then selectively activates only the minimally sufficient generation pathway, eliminating redundant Gaussian computations before primitive instantiation. On a 27.8 square millimeter 28 nm post-layout design, SCARF delivers a 2.94x geometric-mean end-to-end speedup with maximum PSNR degradation below 0.072\%, 2.23 inferences per joule, and 34.5x GPU energy efficiency.},
  code            = {https://github.com/MAdrid1011/SCARF},
  supp            = {https://doi.org/10.5281/zenodo.21482385},
  website         = {https://microarch.org/micro59/},
  bibtex_show     = {true},
  note            = {CCF-A · Accepted},
  selected        = {true}
}

@inproceedings{ma2026ahasd,
  abbr            = {DAC'26},
  title           = {AHASD: Asynchronous Heterogeneous Architecture for LLM Adaptive Drafting Speculative Decoding on Mobile Devices},
  author          = {Ma, Zirui and Fan, Zhihua and Li, Wenxing and Wu, Haibin and Zhang, Fulin and Li, Wenming and Ye, Xiaochun},
  booktitle       = {63rd ACM/IEEE Design Automation Conference},
  year            = {2026},
  preview         = {ahasd.webp},
  abstract        = {Speculative decoding enhances the inference efficiency of large language models (LLMs) by generating drafts using a small draft language model (DLM) and verifying them in batches with a large target language model (TLM). However, adaptive drafting inference on a mobile single-NPU-PIM system faces idle overhead in traditional operator-level synchronous execution and wasted computation in asynchronous execution due to fluctuations in draft length. This paper introduces AHASD, a task-level asynchronous mobile NPU-PIM heterogeneous architecture for speculative decoding. Notably, AHASD achieves parallel drafting on the PIM and verification on a single NPU through task-level DLM-TLM decoupling and specifically, it incorporates Entropy-History-Aware Drafting Control and Time-Aware Pre-Verification Control to dynamically manage adaptive drafting algorithm execution and pre-verification timing, suppressing invalid drafting based on low-confidence drafts. Additionally, AHASD integrates Attention Algorithm Units and Gated Task Scheduling Units within LPDDR5-PIM to enable attention link localization and sub-microsecond task switching on the PIM side. Experimental results for different LLMs and adaptive drafting algorithms show that AHASD achieves up to 4.2x in throughput and 5.6x in energy efficiency improvements over a GPU-only baseline, and 1.5x in throughput and 1.24x in energy efficiency gains over the state-of-the-art GPU+PIM baseline, with hardware overhead below 3\% of the DRAM area.},
  doi             = {10.1145/3770743.3803965},
  arxiv           = {2604.25326},
  html            = {https://arxiv.org/html/2604.25326},
  pdf             = {https://arxiv.org/pdf/2604.25326},
  code            = {https://github.com/MAdrid1011/AHASD},
  website         = {https://dac.com/2026/},
  bibtex_show     = {true},
  note            = {CCF-A · Accepted},
  selected        = {true}
}

@inproceedings{wu2026mlx,
  abbr            = {ISCA'26},
  title           = {MLX: Multi-Layer Execution for Structured LLM Workload Acceleration on Spatial Architectures},
  author          = {Wu, Haibin and Li, Wenming and Fan, Zhihua and Ma, Zirui and Liu, Yuqun and Xia, Tengfei and Liu, Yanhuan and Zhang, Kunming and Ye, Xiaochun and Fan, Dongrui and Weng, Jian},
  booktitle       = {53rd IEEE/ACM International Symposium on Computer Architecture},
  year            = {2026},
  preview         = {mlx.webp},
  abstract        = {Structured sparsity is a promising approach to scaling large-language-model (LLM) inference, but existing forms such as block-diagonal matrices, FFT mixing, and butterfly factorization map inefficiently to GPUs due to deep stage dependencies and limited bulk parallelism. This paper presents MLX, an algorithm-architecture co-design that proposes a unified structured-sparse transformer framework combining semantic-aware FFT, hierarchical butterfly sparsity, and structured attention, and maps it efficiently onto spatial dataflow architectures. MLX is built on Closed Dependency Components (CDCs), a formal abstraction for deterministic forward-only dataflow regions that can be folded across layers and pipelined on compact meshes. Based on this abstraction, MLX introduces a multi-layer execution model with bounded-hop skip-hop routing, tag-based scheduling, and decoupled compute/transfer pipelines to overlap communication and computation across deep operators. We prototype MLX in 12 nm and show that it achieves 3.2x speedup and 3.0x energy savings over Jetson Xavier. A transformer-specialized reduced design further delivers up to 5.7x speedup over prior sparse accelerators. MLX also scales nearly linearly to 8x8 meshes and remains effective for long sequences from 1K to 4K, demonstrating that structured operator semantics can be translated into efficient spatial execution for sparse LLMs.},
  website         = {https://www.iscaconf.org/isca2026/program/},
  award_name      = {Best Paper Nomination},
  award           = {Nominated for the ISCA 2026 Best Paper Award.},
  bibtex_show     = {true},
  note            = {CCF-A · Accepted},
  selected        = {true}
}

@article{wang2026harld,
  abbr            = {JCST'26},
  title           = {HARLD: A RISC-V Based Tightly Coupled Heterogeneous Computing Architecture for Low-Density Parity Check Decoding},
  author          = {Wang, Bing and Ma, Zi-Rui and Wu, Hai-Bin and Zhang, Fu-Lin and Wang, Yue and Fan, Zhi-Hua and Li, Wen-Ming and Ye, Xiao-Chun and Fan, Dong-Rui},
  journal         = {Journal of Computer Science and Technology},
  volume          = {41},
  number          = {2},
  pages           = {774--790},
  month           = {March},
  year            = {2026},
  preview         = {harld.webp},
  abstract        = {Low-density parity check (LDPC) decoding is an efficient error correction method in communication systems, especially in 5G networks, which require high performance and low latency; while common general-purpose architectures cannot meet the requirements. There has been some research on accelerating LDPC decoding, but the current methods still suffer from limitations in performance, flexibility, and communication cost. In this paper, we propose HARLD (Heterogeneous Architecture of RISC-V for LDPC Decoding), a tightly coupled heterogeneous computing architecture based on extended RISC-V for LDPC decoding, consisting of a CPU and a processing array. Compared with a loosely coupled System-on-Chip (SoC)-bus baseline, the tightly coupled design improves throughput by up to 32.4\% and reduces average latency by up to 24.7\% across evaluated configurations, while also enhancing resource and energy efficiency: processing element utilization up to 93.5\%, instruction RAM utilization increased by up to 4.8x, and energy efficiency improved by up to 24.8\%. At the system level, area and power are reduced by 17.6\% and 10.2\%, respectively, versus the loosely coupled design.},
  doi             = {10.1007/s11390-025-5052-5},
  html            = {https://jcst.ict.ac.cn/article/doi/10.1007/s11390-025-5052-5},
  pdf             = {https://jcst.ict.ac.cn/cn/article/pdf/preview/10.1007/s11390-025-5052-5.pdf},
  bibtex_show     = {true},
  note            = {CCF-B · Published},
  selected        = {false}
}

@article{zhong2026bisc,
  abbr            = {CAL'26},
  title           = {BISC: Rethinking Instruction Set Abstractions at Block Granularity},
  author          = {Zhong, An and Hu, Hanzhi and Ma, Zirui and Li, Mengzhu and Wu, Haibin and Zhang, Fulin and Deng, Jinyi and Xu, Ceyu and Li, Wenming and Hu, Yang and Weng, Jian},
  journal         = {IEEE Computer Architecture Letters},
  volume          = {25},
  number          = {1},
  pages           = {222--225},
  month           = {May},
  year            = {2026},
  preview         = {bisc.webp},
  abstract        = {Most widely deployed ISAs for general-purpose processors expose a centralized register file and instruction-granular control flow, forcing modern CPUs to rely on complex microarchitectural mechanisms to reconcile execution with architectural state. Even in simple in-order designs, these abstractions impose back-and-forth execution overheads, while more aggressive processors further amplify them through register renaming, speculation, and in-order retirement. This letter presents the Block-based Instruction Set Computer (BISC), which rethinks ISA abstractions at block granularity. BISC eliminates architectural destination registers by binding each instruction's result to its position within a block, enabling block-local execution driven by operand availability while preserving control-flow semantics across blocks. Control flow is resolved at block entry, amortizing fetch and control overhead across multiple operations and enabling efficient expression of conditional selection without additional control-flow edges. We evaluate BISC using a single-issue in-order core with comparable area to a RISC-V baseline. Despite executing more operations and incurring a larger code footprint, BISC achieves a 34\% geometric mean speedup across benchmarks. These results demonstrate that ISA-level execution abstractions play a critical role in processor efficiency, independent of microarchitectural optimizations.},
  doi             = {10.1109/LCA.2026.3690895},
  html            = {https://researchportal.hkust.edu.hk/en/publications/bisc-rethinking-instruction-set-abstractions-at-block-granularity/},
  bibtex_show     = {true},
  note            = {Published},
  selected        = {false}
}
